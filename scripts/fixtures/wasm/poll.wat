    (i32.store8 (i32.const 136) (i32.const 2))
    (i32.store (i32.const 144) (i32.const 127))
    (i64.store (i32.const 176) (i64.const 202))
    (i32.store8 (i32.const 184) (i32.const 1))
    (i32.store (i32.const 192) (i32.load (i32.const 0)))
    (if (call $poll (i32.const 128) (i32.const 256) (i32.const 2) (i32.const 8)) (then unreachable))
