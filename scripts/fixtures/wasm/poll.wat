  (memory (export "memory") 1)
  (data (i32.const 64) "child\00POLL_READY_OK")
  (func (export "_start") (local $child i32)
    (if (call $pipe (i32.const 0)) (then unreachable))
    (local.set $child (call $spawn (i32.const 64) (i32.const 6) (i32.const 0) (i32.load (i32.const 4)) (i32.const 2)))
    (if (call $close (i32.load (i32.const 4))) (then unreachable))
    (i64.store (i32.const 128) (i64.const 0x0102030405060708))
    (i32.store8 (i32.const 136) (i32.const 1))
    (i32.store (i32.const 144) (i32.load (i32.const 0)))
    (if (call $poll (i32.const 128) (i32.const 256) (i32.const 1) (i32.const 8)) (then unreachable))
    (if (i32.ne (i32.load (i32.const 8)) (i32.const 1)) (then unreachable))
    (if (i64.ne (i64.load (i32.const 256)) (i64.const 0x0102030405060708)) (then unreachable))
    (if (i32.load16_u (i32.const 264)) (then unreachable))
