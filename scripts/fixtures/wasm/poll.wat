    (if (i64.ne (i64.load (i32.const 272)) (i64.const 14)) (then unreachable))
    (if (i32.ne (i32.load16_u (i32.const 280)) (i32.const 1)) (then unreachable))
    ;; Readiness must leave payload bytes in the pipe.
    (i32.store (i32.const 16) (i32.const 512))
    (i32.store (i32.const 20) (i32.const 32))
    (if (call $read (i32.load (i32.const 0)) (i32.const 16) (i32.const 1) (i32.const 24)) (then unreachable))
    (if (i32.ne (i32.load (i32.const 24)) (i32.const 14)) (then unreachable))
    (if (i32.ne (i32.load8_u (i32.const 512)) (i32.const 87)) (then unreachable))
